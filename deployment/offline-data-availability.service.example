[Unit]
Description=Offline Data Automation - Availability Checks
Wants=network-online.target
After=network-online.target
OnFailure=offline-data-automation-failure@%n.service

[Service]
Type=oneshot
User=voptimaise
WorkingDirectory=/home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation
EnvironmentFile=/home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation/.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata

ExecStartPre=/usr/bin/mkdir -p /home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation/logs
ExecStart=/home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation/.venv/bin/python /home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation/src/availability.py

TimeoutStartSec=10m
KillMode=control-group
TimeoutStopSec=30s
PrivateTmp=true

StandardOutput=journal
StandardError=append:/home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation/logs/offline-data-error.log

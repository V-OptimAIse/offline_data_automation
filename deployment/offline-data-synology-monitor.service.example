[Unit]
Description=Offline Data Synology Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voptimaise
WorkingDirectory=/home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation
ExecStart=/home/voptimaise/Desktop/evonith/dataloading/offline_data/offline_data_automation/.venv/bin/python src/monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
